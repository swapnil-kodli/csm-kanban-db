# Signal CS backend — copy to .env and fill in. .env is gitignored and must
# stay that way: everything below is a credential.
#
# Nothing here is ever read by the frontend. The browser bundle talks to this
# backend over /api and never holds a database credential of any kind.

APP_VERSION=2.0.0

# --- database ----------------------------------------------------------------
# Default: a SQLite file on the compose volume. Zero config, survives restarts,
# and is the right answer for a single-team deployment.
DATABASE_URL=sqlite:///./data/signal.db

# Supabase (managed Postgres). Use the POOLER host, not db.<ref>.supabase.co:
# the app holds a connection pool and the direct endpoint has a low connection
# ceiling. Port 5432 is the session pooler; 6543 is the transaction pooler,
# which does not support prepared statements — if you use 6543, the URL needs
# ?prepare_threshold=0 for psycopg.
#
#   DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# The password is the database password from
#   Supabase dashboard -> Project Settings -> Database -> Connection string
# It is NOT the anon key and NOT the service_role key. Those are PostgREST
# credentials; this app does not use PostgREST at all, it speaks the Postgres
# wire protocol directly. The anon key must never appear in this file or in the
# frontend bundle.
#
# Requires the psycopg driver:  pip install "psycopg[binary]"
#
# Before switching, confirm the host running this container can actually reach
# Supabase — see tools/egress-probe. A blocked outbound port fails at boot, not
# at first query.
#
# Postgres in the compose stack (the fallback when egress is blocked):
#   DATABASE_URL=postgresql+psycopg://signal:<password>@db:5432/signal

# --- demo fixture ------------------------------------------------------------
# Off by default. On, and ONLY when the database is completely empty, this
# loads the twelve-client demo book. Never enable it on a real deployment: it
# is a fixture, not a starting point.
SEED_DEMO=false

# --- sign-in (optional) ------------------------------------------------------
# Off by default. With it off the app runs as the single bootstrap CSM, which is
# what every demo and every existing deployment expects. Turning it on must be a
# decision, not something a dependency bump imposes.
AUTH_ENABLED=false

# Who may sign in. Comma-separated, no @. EMPTY MEANS NOBODY, not everybody —
# failing closed makes a forgotten value visible at the first login attempt
# instead of quietly admitting every Google account on the internet.
ALLOWED_EMAIL_DOMAINS=revspot.ai

# Encrypts the stored Gmail refresh token. REQUIRED before Gmail can be
# connected. Deliberately not generated per boot: an in-memory key would
# invalidate every grant on restart and send users back through consent with no
# explanation. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Gmail integration (optional) --------------------------------------------
# Off by default: the app is fully usable and demo-able with no Google project.
GMAIL_ENABLED=false

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). The secret must never reach the frontend bundle.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must EXACTLY match a URI registered on that OAuth client. Google requires an
# exact match, and the frontend's nginx strips /p/{slug} before proxying, so the
# backend cannot derive this from the request. Register BOTH of these:
#   https://marketplace.revspot.ai/p/{slug}/api/google/callback
#   http://localhost:5173/api/google/callback
GOOGLE_REDIRECT_URI=
