# Signal CS backend — copy to .env and fill in. .env is gitignored.
DATABASE_URL=sqlite:///./data/signal.db
APP_VERSION=2.0.0

# --- Gmail integration (optional) --------------------------------------------
# Off by default: the app is fully usable and demo-able with no Google project.
GMAIL_ENABLED=false

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). The secret must never reach the frontend bundle.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must EXACTLY match a URI registered on that OAuth client. Google requires an
# exact match, and the frontend's nginx strips /p/{slug} before proxying, so the
# backend cannot derive this from the request. Register BOTH of these:
#   https://marketplace.revspot.ai/p/{slug}/api/google/callback
#   http://localhost:5173/api/google/callback
GOOGLE_REDIRECT_URI=
