# Marketplace injects these at build time. Both are optional now: the app
# resolves its mount point from the live URL at runtime, so a missing, empty or
# stale value cannot blank the page.
#
# BASE_PATH is deliberately left unset. With no value, Vite emits relative asset
# URLs (./assets/...), which resolve correctly under whatever /p/{slug}/ the
# deployment is actually served at. Set it to /p/{slug}/ only if you want
# absolute asset URLs and you know the slug.
VITE_API_URL=
